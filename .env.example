# TDCP Web — environment template (no secrets)
# Copy to .env and adjust locally. Never commit real secrets.

# Dev server (package.json / scripts/start.sh use 8080)
# PORT=8080

# Cuentas de usuario (Better Auth, email + contraseña). "true" = registro/login reales.
VITE_AUTH_ENABLED=true

# --- Authorization Authority (production path) ---
# When set, Gatekeeper/runtime prefer HttpAuthorityClient over in-process Oracle.
# TDCP_AUTHORITY_URL=http://127.0.0.1:8787
# VITE_TDCP_AUTHORITY_URL=http://127.0.0.1:8787
# TDCP_AUTHORITY_PORT=8787
# TDCP_AUTHORITY_DATA_DIR=./data/authority

# Admin auth mode: token (default, local) | oidc | mtls | oidc+mtls
# See docs/ADMIN_AUTH.md — not a full enterprise IdP product.
# TDCP_AUTHORITY_ADMIN_AUTH=token
# Admin Bearer for register / revoke / restore / admin lists (mode=token only).
# Generate: openssl rand -hex 32
# TDCP_AUTHORITY_ADMIN_TOKEN=
# LOCAL DEMO ONLY — puts admin token in the browser bundle. Never for production web:
# VITE_TDCP_AUTHORITY_ADMIN_TOKEN=

# OIDC (when TDCP_AUTHORITY_ADMIN_AUTH=oidc or oidc+mtls)
# TDCP_OIDC_ISSUER=https://your-idp.example/realms/tdcp
# TDCP_OIDC_AUDIENCE=tdcp-authority
# TDCP_OIDC_JWKS_URL=   # optional; discovered from issuer if omitted
# TDCP_OIDC_ADMIN_CLAIM=tdcp_admin
# TDCP_OIDC_ADMIN_CLAIM_VALUE=

# mTLS / HTTPS (when TDCP_AUTHORITY_ADMIN_AUTH=mtls or oidc+mtls)
# ./scripts/gen-dev-mtls.sh  # DEV ONLY local CA+certs
# TDCP_AUTHORITY_TLS_CERT_FILE=./data/mtls-dev/server.crt
# TDCP_AUTHORITY_TLS_KEY_FILE=./data/mtls-dev/server.key
# TDCP_MTLS_CA_FILE=./data/mtls-dev/ca.crt
# TDCP_MTLS_ALLOWED_CNS=tdcp-admin-dev

# Signing backend: file only (no AWS KMS dependency). Encrypt private JWK at rest:
# TDCP_SIGNING_BACKEND=file
# TDCP_AUTHORITY_KEY_PASSPHRASE=  # openssl rand -hex 32
# TDCP_AUTHORITY_KEY_FILE=        # optional path to passphrase file (mode 0600)

# Simple in-memory rate limit for challenge/authorize (per client IP)
# TDCP_AUTHORITY_RATE_MAX=120
# TDCP_AUTHORITY_RATE_WINDOW_MS=60000
# TDCP_AUTHORITY_RATE_MODE=memory   # or "file" for multi-process shared dir under DATA_DIR/rate-limit
# TDCP_TRUST_PROXY=0               # set 1 only behind a trusted reverse proxy (X-Forwarded-For)

# Demo UX badge / evaluator hints (does NOT weaken crypto)
# TDCP_DEMO_MODE=1
# VITE_TDCP_DEMO_MODE=1

# --- Base de datos de cuentas (Supabase Postgres) ---
# Sin DATABASE_URL se usa PGLite en memoria (se borra al reiniciar).
# Supabase → Connect → "Session pooler" (IPv4, puerto 5432). La conexión directa
# db.<ref>.supabase.co es solo IPv6. Codifica caracteres especiales de la contraseña (%40 para @, etc.).
# DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres
# Certificado CA de Supabase (Database → Settings → SSL) para verificar TLS por completo:
# DATABASE_CA_CERT=./certs/supabase-prod-ca.crt
# DATABASE_POOL_MAX=5

# Better Auth — obligatorio en producción. Genera con: openssl rand -hex 32
# BETTER_AUTH_SECRET=
# URL pública de la app (debe coincidir con el dominio real)
# BETTER_AUTH_URL=http://localhost:8080

# Correo transaccional (Resend): verificación de cuenta y "olvidé mi contraseña".
# Mismos nombres que en la plataforma de producción. Sin esto, en desarrollo el
# enlace se imprime en consola. (TDCP_MAIL_FROM se acepta como alias antiguo.)
# RESEND_API_KEY=re_...
# EMAIL_FROM="TDCP <no-reply@tu-dominio.com>"
# Exigir correo verificado para iniciar sesión (por defecto: false)
# TDCP_REQUIRE_EMAIL_VERIFICATION=false
# BETTER_AUTH_SECRET=generate-a-long-random-string

# --- Vercel production (required by `npm run vercel-build`) ---
# Do not deploy the browser Oracle or anonymous authentication to Vercel. The
# build intentionally fails unless all of these are set in Vercel Production.
# VITE_AUTH_ENABLED=true
# DATABASE_URL=postgresql://...
# BETTER_AUTH_SECRET=<32+ random characters>
# BETTER_AUTH_URL=https://app.example.com
# VITE_TDCP_AUTHORITY_URL=https://authority.example.com

# Optional WebRTC STUN for multiplayer helpers (comma-separated)
# VITE_STUN_URLS=stun:stun.l.google.com:19302

# Preview / smoke tooling
# PREVIEW_READY_TIMEOUT_MS=60000
# BROWSER_SMOKE_TIMEOUT_MS=45000

# --- Optional: Smart Token Prod (self-hosted; free) ---
# See docs/CSG_SMART_TOKEN_BRIDGE.md — never persist the master secret in TDCP.
# SMART_TOKEN_API_URL=http://127.0.0.1:8000
# SMART_TOKEN_API_KEY=
# Master is supplied per protect/open request only (operator path).

# --- Optional: CSG / Sello sidecar (self-hosted; free) ---
# CSG_SEAL_URL=http://127.0.0.1:8010

# --- Smart Token / CSG (browser + sidecars) ---
# VITE_SMART_TOKEN_API_URL=http://127.0.0.1:8000
# VITE_SMART_TOKEN_API_KEY=
# VITE_CSG_SEAL_URL=http://127.0.0.1:8010
# CSG_DATA_DIR=./data/csg-sidecar
# CSG_NOTARIO_NAME=TDCP-Notario

# --- Authority remoto con sesión de usuario (docs/AUTHORITY_USER_AUTH.md) ---
# App web:
# VITE_TDCP_AUTHORITY_URL=http://127.0.0.1:8787
# TDCP_USER_AUDIENCE=tdcp-authority
# Authority (proceso aparte):
# TDCP_USER_AUTH=required
# TDCP_USER_JWKS_URL=http://127.0.0.1:8080/api/auth/jwks
# TDCP_USER_ISSUER=http://localhost:8080
# TDCP_CORS_ORIGINS=http://localhost:8080
#
# USB-HSM (llave USB FIDO2 como ID físico). Por defecto rpId/origin salen de TDCP_USER_ISSUER.
# El rpId debe ser el dominio de la app (sin puerto ni esquema); los origins, las URLs exactas.
# TDCP_WEBAUTHN_RP_ID=app.tu-dominio.com
# TDCP_WEBAUTHN_ORIGINS=https://app.tu-dominio.com
# TDCP_WEBAUTHN_RP_NAME=TDCP
# TDCP_USB_HSM_MAX_PER_USER=5
# TDCP_REQUIRE_VERIFIED_EMAIL=true   # solo cuentas con correo verificado registran llaves
