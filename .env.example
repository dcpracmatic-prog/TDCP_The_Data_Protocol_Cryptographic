# TDCP Web — environment template (no secrets)
# Copy to .env and adjust locally. Never commit real secrets.

# Dev server (package.json / scripts/start.sh use 8080)
# PORT=8080

# Auth UI flag for the App Builder shell (default: auth off in local preview)
# Set to "true" only when you intentionally enable Better Auth providers.
VITE_AUTH_ENABLED=false

# --- Authorization Authority (production path) ---
# When set, Gatekeeper/runtime prefer HttpAuthorityClient over in-process Oracle.
# TDCP_AUTHORITY_URL=http://127.0.0.1:8787
# VITE_TDCP_AUTHORITY_URL=http://127.0.0.1:8787
# TDCP_AUTHORITY_PORT=8787
# TDCP_AUTHORITY_DATA_DIR=./data/authority

# Admin auth mode: token (default, local) | oidc | mtls | oidc+mtls
# See docs/ADMIN_AUTH.md — not a full enterprise IdP product.
# TDCP_AUTHORITY_ADMIN_AUTH=token
# Admin Bearer for register / revoke / restore / admin lists (mode=token only).
# Generate: openssl rand -hex 32
# TDCP_AUTHORITY_ADMIN_TOKEN=
# LOCAL DEMO ONLY — puts admin token in the browser bundle. Never for production web:
# VITE_TDCP_AUTHORITY_ADMIN_TOKEN=

# OIDC (when TDCP_AUTHORITY_ADMIN_AUTH=oidc or oidc+mtls)
# TDCP_OIDC_ISSUER=https://your-idp.example/realms/tdcp
# TDCP_OIDC_AUDIENCE=tdcp-authority
# TDCP_OIDC_JWKS_URL=   # optional; discovered from issuer if omitted
# TDCP_OIDC_ADMIN_CLAIM=tdcp_admin
# TDCP_OIDC_ADMIN_CLAIM_VALUE=

# mTLS / HTTPS (when TDCP_AUTHORITY_ADMIN_AUTH=mtls or oidc+mtls)
# ./scripts/gen-dev-mtls.sh  # DEV ONLY local CA+certs
# TDCP_AUTHORITY_TLS_CERT_FILE=./data/mtls-dev/server.crt
# TDCP_AUTHORITY_TLS_KEY_FILE=./data/mtls-dev/server.key
# TDCP_MTLS_CA_FILE=./data/mtls-dev/ca.crt
# TDCP_MTLS_ALLOWED_CNS=tdcp-admin-dev

# Signing backend: file (default, extractable JWK — NOT production-grade) | kms-stub (hook only)
# TDCP_SIGNING_BACKEND=file

# Simple in-memory rate limit for challenge/authorize (per client IP)
# TDCP_AUTHORITY_RATE_MAX=120
# TDCP_AUTHORITY_RATE_WINDOW_MS=60000

# Demo UX badge / evaluator hints (does NOT weaken crypto)
# TDCP_DEMO_MODE=1
# VITE_TDCP_DEMO_MODE=1

# Optional: Postgres URL for Better Auth / app-data (omit for PGLite in-memory)
# DATABASE_URL=postgres://user:pass@localhost:5432/tdcp

# Better Auth (only needed when VITE_AUTH_ENABLED=true and DATABASE_URL is set)
# BETTER_AUTH_URL=http://127.0.0.1:8080
# BETTER_AUTH_SECRET=generate-a-long-random-string

# Optional WebRTC STUN for multiplayer helpers (comma-separated)
# VITE_STUN_URLS=stun:stun.l.google.com:19302

# Preview / smoke tooling
# PREVIEW_READY_TIMEOUT_MS=60000
# BROWSER_SMOKE_TIMEOUT_MS=45000
